{
  "name": "studio-luce",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "dev:vinext": "vite dev --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "build:vinext": "vite build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json --ip 0.0.0.0 --port 3000",
    "deploy": "wrangler deploy",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@vinext/cloudflare": "^1.4.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-server-dom-webpack": "^19.3.1",
    "vinext": "^1.4.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitejs/plugin-rsc": "^0.5.39",
    "typescript": "5.9.3",
    "vite": "^8.3.8",
    "wrangler": "4.167.0"
  },
  "type": "module"
}
