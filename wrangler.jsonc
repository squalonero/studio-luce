{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Workers Builds runs `npx wrangler deploy` after `npm run build`.
  // `npm run build` is `vite build`, which writes the static files this
  // config uploads from dist/client. The Worker name must match the
  // Worker connected to the GitHub repository.
  "name": "studio-luce",
  "compatibility_date": "2026-11-24",
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "html_handling": "none",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*",
      "!/_next/static/*",
      "!/*/_next/static/*"
    ]
  }
}

